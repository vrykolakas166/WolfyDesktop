<Project>
  <!-- Shared by every project in the solution. -->
  <PropertyGroup>
    <Product>WolfyDesktop</Product>
    <Company>Wolfy Inc</Company>
    <Authors>Phuc Pham Hong</Authors>
    <Copyright>Copyright © Phuc Pham Hong</Copyright>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Needed for IDE0005 (unused usings) to run on build; missing-doc warnings stay off. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    The version comes from git tags (MinVer): building the commit tagged v1.3.0 gives 1.3.0, and
    later untagged commits give 1.3.1-preview.0.N. Release by tagging; see scripts/New-Release.ps1.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="8.0.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
