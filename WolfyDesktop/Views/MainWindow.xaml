<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="WolfyDesktop.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WolfyDesktop.Views"
    Title="WolfyDesktop">

    <!--  Focusable so keyboard shortcuts work from launch, before anything is clicked  -->
    <Grid
        x:Name="RootGrid"
        Background="Black"
        IsTabStop="True"
        KeyboardAcceleratorPlacementMode="Hidden"
        Loaded="RootGrid_Loaded"
        PointerMoved="RootGrid_PointerMoved"
        PointerCaptureLost="RootGrid_PointerCaptureLost"
        PointerPressed="RootGrid_PointerPressed"
        PointerReleased="RootGrid_PointerReleased"
        UseSystemFocusVisuals="False">

        <Grid.Resources>
            <!--  One row of the F1 help: a key cap and what it does  -->
            <DataTemplate x:Key="ShortcutTemplate" x:DataType="local:Shortcut">
                <Grid Padding="0,3" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Padding="8,2"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="{x:Bind Keys}" />
                    </Border>
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Text="{x:Bind Action}" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <!--  Keyboard shortcuts (see README and the F1 help)  -->
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Key="F1" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="F2" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="F4" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="F6" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="F10" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="F11" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="F12" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="T" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Space" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Up" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Down" Invoked="Accelerator_Invoked" />
            <KeyboardAccelerator Key="Escape" Invoked="Accelerator_Invoked" />
        </Grid.KeyboardAccelerators>

        <!--  Chill mode background video  -->
        <MediaPlayerElement
            x:Name="BackgroundVideo"
            AreTransportControlsEnabled="False"
            Opacity="0.5"
            Stretch="UniformToFill" />

        <!--  Clock: scales with the window; the top quarter is left empty  -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="3*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Viewbox
                Grid.Row="1"
                Grid.Column="1"
                VerticalAlignment="Top"
                Stretch="Uniform">
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Resources>
                        <!--  Fixed digit width keeps the clock from shifting as proportional digits change  -->
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="{StaticResource SFProDisplay}" />
                            <Setter Property="FontSize" Value="200" />
                            <Setter Property="TextAlignment" Value="Center" />
                        </Style>
                        <x:Double x:Key="DigitWidth">128</x:Double>
                    </StackPanel.Resources>

                    <TextBlock x:Name="HourTens" Width="{StaticResource DigitWidth}" Text="0" />
                    <TextBlock x:Name="HourUnits" Width="{StaticResource DigitWidth}" Text="0" />
                    <TextBlock Text=":" />
                    <TextBlock x:Name="MinuteTens" Width="{StaticResource DigitWidth}" Text="0" />
                    <TextBlock x:Name="MinuteUnits" Width="{StaticResource DigitWidth}" Text="0" />
                    <TextBlock Text=":" />
                    <TextBlock x:Name="SecondTens" Width="{StaticResource DigitWidth}" Text="0" />
                    <TextBlock x:Name="SecondUnits" Width="{StaticResource DigitWidth}" Text="0" />
                </StackPanel>
            </Viewbox>
        </Grid>

        <!--  Audio controls: shown on mouse movement, hidden after a few idle seconds  -->
        <StackPanel
            x:Name="AudioControls"
            Margin="20,0,0,20"
            HorizontalAlignment="Left"
            VerticalAlignment="Bottom"
            Opacity="0"
            Orientation="Horizontal"
            Spacing="15"
            Visibility="Collapsed">
            <!--  No keyboard focus, so Space always goes to the shortcut instead of clicking twice  -->
            <Button
                Width="40"
                Height="40"
                AllowFocusOnInteraction="False"
                Command="{x:Bind ViewModel.TogglePlayPauseCommand}"
                ToolTipService.ToolTip="Play/Pause (Space)">
                <FontIcon FontSize="13" Glyph="{x:Bind PlayPauseGlyph(ViewModel.IsAudioPlaying), Mode=OneWay}" />
            </Button>
            <StackPanel
                VerticalAlignment="Center"
                Orientation="Horizontal"
                Spacing="10">
                <FontIcon FontSize="13" Glyph="&#xE767;" />
                <Slider
                    Width="100"
                    AllowFocusOnInteraction="False"
                    Maximum="100"
                    Minimum="0"
                    ToolTipService.ToolTip="Volume (Up/Down)"
                    Value="{x:Bind ViewModel.Volume, Mode=TwoWay}" />
            </StackPanel>
        </StackPanel>

        <!--  Update ready  -->
        <InfoBar
            MaxWidth="380"
            Margin="0,0,20,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            IsOpen="{x:Bind ViewModel.IsUpdateBannerOpen, Mode=TwoWay}"
            Message="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
            Severity="Informational"
            Title="Update ready">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.RestartToUpdateCommand}" Content="Restart now" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!--  Panels (F1, F2, F6, F10): one card over a dimmed backdrop; pressing the backdrop closes it  -->
        <Grid
            x:Name="PanelLayer"
            Opacity="0"
            Visibility="Collapsed">
            <Border x:Name="PanelBackdrop" Background="{ThemeResource SmokeFillColorDefaultBrush}" />

            <!--  The margin is the gap kept around the card when the window grows to fit it  -->
            <Border
                x:Name="PanelCard"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                RenderTransformOrigin="0.5,0.5"
                TabFocusNavigation="Cycle">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="PanelCardScale" />
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Padding="24,16,12,0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="PanelTitle"
                            VerticalAlignment="Center"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="PanelCloseButton_Click"
                            ToolTipService.ToolTip="Close (Esc)">
                            <FontIcon FontSize="12" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <ScrollViewer
                        x:Name="PanelScroller"
                        Grid.Row="1"
                        Padding="24,12,24,24"
                        IsTabStop="True"
                        UseSystemFocusVisuals="False"
                        VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!--  F1  -->
                            <StackPanel
                                x:Name="HelpPanel"
                                Width="340"
                                Spacing="16"
                                Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Keyboard" />
                                    <ItemsControl x:Name="KeyboardShortcutList" ItemTemplate="{StaticResource ShortcutTemplate}" />
                                </StackPanel>
                                <StackPanel Spacing="6">
                                    <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="Mouse (windowed)" />
                                    <ItemsControl x:Name="MouseShortcutList" ItemTemplate="{StaticResource ShortcutTemplate}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  F2  -->
                            <RadioButtons
                                x:Name="ThemeRadioButtons"
                                MaxColumns="3"
                                SelectionChanged="ThemeRadioButtons_SelectionChanged"
                                Visibility="Collapsed" />

                            <!--  F6: a fresh audio manager each time it opens, then the playback controls setting  -->
                            <StackPanel
                                x:Name="AudioPanel"
                                Width="500"
                                Spacing="15"
                                Visibility="Collapsed">
                                <Border x:Name="AudioManagerHost" />

                                <Border
                                    Height="1"
                                    Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                                    Opacity="0.5" />

                                <StackPanel Spacing="4">
                                    <TextBlock FontWeight="SemiBold" Text="Playback controls" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="How visible the play/pause and volume controls are. At 0% they stay hidden; Space and Up/Down still work."
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <Slider
                                            IsThumbToolTipEnabled="False"
                                            LargeChange="10"
                                            Maximum="100"
                                            Minimum="0"
                                            SmallChange="5"
                                            StepFrequency="5"
                                            Value="{x:Bind ViewModel.ControlsOpacity, Mode=TwoWay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{x:Bind PercentText(ViewModel.ControlsOpacity), Mode=OneWay}"
                                            TextAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!--  F10  -->
                            <StackPanel
                                x:Name="AboutPanel"
                                Width="340"
                                Spacing="12"
                                Visibility="Collapsed">
                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.VersionText}" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind ViewModel.UpdateStatusText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <ProgressBar Visibility="{x:Bind ViewModel.IsDownloadingUpdate, Mode=OneWay}" Value="{x:Bind ViewModel.UpdateDownloadProgress, Mode=OneWay}" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.CheckForUpdatesCommand}"
                                    Content="Check for updates"
                                    Visibility="{x:Bind ViewModel.IsUpdateSupported}" />
                                <Button
                                    HorizontalAlignment="Stretch"
                                    Command="{x:Bind ViewModel.RestartToUpdateCommand}"
                                    Content="Restart to update"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Visibility="{x:Bind ViewModel.IsUpdateReady, Mode=OneWay}" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!--  Short status message, e.g. after toggling always on top  -->
        <Border
            x:Name="Toast"
            Margin="0,40,0,0"
            Padding="16,8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            IsHitTestVisible="False"
            Opacity="0"
            Visibility="Collapsed">
            <TextBlock x:Name="ToastText" />
        </Border>

        <!--  Welcome splash  -->
        <Border
            x:Name="WelcomePanel"
            Background="Black"
            IsHitTestVisible="False"
            Loaded="WelcomePanel_Loaded">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <Image
                    x:Name="WelcomeImage"
                    Width="300"
                    Height="300"
                    Stretch="Uniform">
                    <Image.Source>
                        <BitmapImage DecodePixelWidth="300" UriSource="ms-appx:///Assets/loading.gif" />
                    </Image.Source>
                </Image>
                <TextBlock
                    HorizontalAlignment="Center"
                    Foreground="#99FFFFFF"
                    Text="Press F1 for help" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
