<UserControl
    x:Class="WolfyDesktop.AudioManagerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:WolfyDesktop"
    xmlns:models="using:WolfyDesktop.Models"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Width="500"
    mc:Ignorable="d">

    <StackPanel Spacing="15">
        <!--  Warning Message  -->
        <TextBlock
            x:Name="MessageText"
            Foreground="Orange"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!--  Status  -->
        <StackPanel
            Margin="0,0,0,10"
            Orientation="Horizontal"
            Spacing="8">
            <FontIcon
                x:Name="StatusIcon"
                VerticalAlignment="Center"
                FontSize="16"
                Glyph="&#xE7BA;" />
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                TextWrapping="Wrap" />
        </StackPanel>

        <!--  Download Default Audio Section  -->
        <StackPanel Spacing="10">
            <TextBlock FontWeight="SemiBold" Text="Default Audio (Lofi Rain)" />

            <!--  Progress Bar  -->
            <ProgressBar
                x:Name="ProgressBar"
                IsIndeterminate="False"
                Visibility="Collapsed" />

            <!--  Progress Text  -->
            <TextBlock
                x:Name="ProgressText"
                Foreground="{ThemeResource TextFillColorPrimary}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />

            <!--  Download Button  -->
            <Button
                x:Name="DownloadButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="DownloadButton_Click"
                Content="Download Default Audio" />

            <!--  Cancel Download Button  -->
            <Button
                x:Name="CancelButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Click="CancelButton_Click"
                Content="Cancel Download"
                Visibility="Collapsed" />
        </StackPanel>

        <Border
            Height="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Opacity="0.5" />

        <!--  Custom Music Management Section  -->
        <StackPanel Spacing="10">
            <TextBlock FontWeight="SemiBold" Text="Your Music Library" />

            <!--  Music List  -->
            <ListView
                x:Name="MusicListView"
                Height="200"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="4"
                SelectionChanged="MusicListView_SelectionChanged"
                SelectionMode="Single">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:MusicItem">
                        <Grid Padding="8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Music Icon  -->
                            <FontIcon
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                FontSize="16"
                                Glyph="&#xE8D6;" />

                            <!--  Music Info  -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind DisplayName}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Opacity="0.8"
                                    Text="{x:Bind SizeText}" />
                            </StackPanel>

                            <!--  Default Badge  -->
                            <Border
                                Grid.Column="2"
                                Padding="8,4"
                                VerticalAlignment="Center"
                                Background="{ThemeResource AccentFillColorDefaultBrush}"
                                CornerRadius="4"
                                Visibility="{x:Bind IsDefaultVisibility}">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="DEFAULT" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Action Buttons  -->
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button
                    x:Name="AddMusicButton"
                    Grid.Column="0"
                    HorizontalAlignment="Stretch"
                    Click="AddMusicButton_Click"
                    Content="Add Music" />

                <Button
                    x:Name="SetDefaultButton"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    Click="SetDefaultButton_Click"
                    Content="Set Default"
                    IsEnabled="False" />

                <Button
                    x:Name="RemoveMusicButton"
                    Grid.Column="2"
                    HorizontalAlignment="Stretch"
                    Click="RemoveMusicButton_Click"
                    Content="Remove"
                    IsEnabled="False" />
            </Grid>
        </StackPanel>

        <Border
            Height="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}"
            Opacity="0.5" />

        <!--  Open Folder Button  -->
        <Button
            x:Name="OpenFolderButton"
            HorizontalAlignment="Stretch"
            Click="OpenFolderButton_Click"
            Content="Open Musics Folder" />
    </StackPanel>
</UserControl>
