<?xml version="1.0" encoding="utf-8" ?>
<Application
    x:Class="WolfyDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <!--  Subset to the clock's characters (0-9 and ':') to save 3.5 MB; subset the full font again to show anything else  -->
            <FontFamily x:Key="SFProDisplay">/Assets/font/SF-Pro-Display-Bold.otf#SF Pro Display</FontFamily>
        </ResourceDictionary>
    </Application.Resources>
</Application>
